<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DdraigBench.ViewModels"
             xmlns:controls="using:DdraigBench.Controls"
             xmlns:editor="using:AvaloniaEdit"
             x:Class="DdraigBench.Views.QueryTabView"
             x:DataType="vm:QueryTabViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <editor:TextEditor Grid.Row="0"
                           Margin="8"
                           Height="160"
                           controls:EditorText.Text="{Binding Sql, Mode=TwoWay}"
                           ShowLineNumbers="True"
                           WordWrap="False"
                           FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="8,0,8,6">
            <TextBlock Text="行数上限" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding MaxRows}"
                           Minimum="1"
                           Maximum="100000"
                           Increment="100"
                           Width="150" />
            <TextBlock Text="（网格按行虚拟化，只渲染可见行）"
                       VerticalAlignment="Center"
                       Opacity="0.7" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  Margin="8,0"
                  ItemsSource="{Binding Rows}"
                  controls:ResultColumns.Headers="{Binding Columns}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="False" />

        <TextBlock Grid.Row="3"
                   Margin="8"
                   Text="{Binding Status}"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
