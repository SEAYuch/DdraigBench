<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DdraigBench.ViewModels"
        x:Class="DdraigBench.Views.ExportDialogView"
        x:DataType="vm:ExportDialogViewModel"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16" Spacing="6">
        <TextBlock Text="保存位置" />
        <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding FilePath}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="浏览…" Command="{Binding BrowseCommand}" />
        </Grid>

        <StackPanel IsVisible="{Binding IsInsert}" Spacing="6">
            <TextBlock Text="目标表名（INSERT INTO …）" />
            <TextBox Text="{Binding TableName}" />
        </StackPanel>

        <TextBlock Text="{Binding Error}"
                   IsVisible="{Binding HasError}"
                   Foreground="#C42B1C"
                   TextWrapping="Wrap" />

        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
            <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="导出" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" />
        </Grid>
    </StackPanel>

</Window>
