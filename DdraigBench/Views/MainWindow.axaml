<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DdraigBench.ViewModels"
        xmlns:views="using:DdraigBench.Views"
        xmlns:connections="using:DdraigBench.Core.Connections"
        xmlns:controls="using:DdraigBench.Controls"
        xmlns:ic="using:FluentIcons.Avalonia.Fluent"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="DdraigBench.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1180" Height="760" MinWidth="760" MinHeight="520"
        Title="DdraigBench">

    <Window.Styles>
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
        </Style>
        <Style Selector="Button.command-button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Border.section-header">
            <Setter Property="Background" Value="{DynamicResource WorkbenchSubtleBrush}" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="Button.command-button.accent">
            <Setter Property="Background" Value="{DynamicResource WorkbenchAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchAccentTextBrush}" />
        </Style>
        <Style Selector="Border.tool-divider">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Background" Value="{DynamicResource WorkbenchBorderBrush}" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <ContextMenu x:Key="ObjectContextMenu">
            <MenuItem Header="查看数据" Command="{Binding #RootWindow.DataContext.OpenDataCommand}" CommandParameter="{Binding}" IsVisible="{ReflectionBinding CanOpenData}" />
            <MenuItem Header="预览 DDL" Command="{Binding #RootWindow.DataContext.PreviewDdlCommand}" CommandParameter="{Binding}" IsVisible="{ReflectionBinding CanPreviewDdl}" />
            <MenuItem Header="重试加载" Command="{Binding #RootWindow.DataContext.RetryLoadCommand}" CommandParameter="{Binding}" IsVisible="{ReflectionBinding LoadFailed}" />
        </ContextMenu>
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewQueryCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding ExecuteSelectedQueryCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding SelectedTab.CancelCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshSelectedDataCommand}" />
    </Window.KeyBindings>

    <DockPanel Background="{DynamicResource WorkbenchBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource WorkbenchPanelBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="8,6">
                <Button Classes="command-button" Command="{Binding OpenConnectionCommand}" ToolTip.Tip="新建并连接数据库">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <ic:FluentIcon Icon="Database" IconSize="Size16" />
                        <TextBlock Text="新建连接" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="command-button" Command="{Binding NewQueryCommand}" ToolTip.Tip="Ctrl+N">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <ic:FluentIcon Icon="DocumentAdd" IconSize="Size16" />
                        <TextBlock Text="新建查询" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Classes="tool-divider" />
                <Button Classes="command-button accent" Command="{Binding ExecuteSelectedQueryCommand}" IsEnabled="{Binding SelectedTab.CanRun}" ToolTip.Tip="F5">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <ic:FluentIcon Icon="Play" IconVariant="Filled" IconSize="Size16" />
                        <TextBlock Text="运行" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="command-button" Command="{Binding SelectedTab.CancelCommand}" IsEnabled="{Binding SelectedTab.CanCancel}" ToolTip.Tip="Esc">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <ic:FluentIcon Icon="Stop" IconSize="Size16" />
                        <TextBlock Text="取消" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Classes="tool-divider" />
                <CheckBox Content="事务" IsChecked="{Binding SelectedTab.UseTransaction}" VerticalAlignment="Center" Margin="4,0" />
                <Button Classes="command-button" Command="{Binding SelectedTab.CommitCommand}" IsEnabled="{Binding SelectedTab.HasTransaction}" Content="提交" />
                <Button Classes="command-button" Command="{Binding SelectedTab.RollbackCommand}" IsEnabled="{Binding SelectedTab.HasTransaction}" Content="回滚" />
                <Border Classes="tool-divider" />
                <Button Classes="command-button" Command="{Binding SelectedTab.ExportCsvCommand}" IsEnabled="{Binding SelectedTab.CanExport}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <ic:FluentIcon Icon="ArrowExport" IconSize="Size16" />
                        <TextBlock Text="导出 CSV" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="command-button" Command="{Binding SelectedTab.ExportInsertCommand}" IsEnabled="{Binding SelectedTab.CanExport}" Content="导出 INSERT" />
                <Button Classes="command-button" Command="{Binding PreviewSelectedDdlCommand}" IsEnabled="{Binding CanPreviewDdl}" Content="预览 DDL" />
                <Button Classes="command-button" Command="{Binding OpenSelectedDataCommand}" IsEnabled="{Binding CanOpenSelectedData}" Content="查看数据" />
                <Border Classes="tool-divider" />
                <Button Classes="command-button" Command="{Binding ToggleNavigatorCommand}" ToolTip.Tip="显示/隐藏导航器">
                    <ic:FluentIcon Icon="PanelLeft" IconSize="Size16" />
                </Button>
                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeName}"
                          MinWidth="112" VerticalAlignment="Center" ToolTip.Tip="界面外观">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="10,8,10,0" Padding="10,7" CornerRadius="4"
                BorderThickness="1" BorderBrush="{DynamicResource WorkbenchWarningBorderBrush}" Background="{DynamicResource WorkbenchWarningSurfaceBrush}"
                IsVisible="{Binding HasSecurityWarning}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:FluentIcon Icon="Warning" IconVariant="Filled" IconSize="Size16" Foreground="{DynamicResource WorkbenchWarningTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SecurityWarning}" Foreground="{DynamicResource WorkbenchWarningTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource WorkbenchPanelBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18">
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ProtectorName, StringFormat='保护：{0}'}" Foreground="{DynamicResource WorkbenchMutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding ActiveConnectionName}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid controls:WorkbenchLayout.NavigatorVisible="{Binding IsNavigatorVisible}" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="10,10,0,10" Background="{DynamicResource WorkbenchPanelBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="1" CornerRadius="5"
                    IsVisible="{Binding IsNavigatorVisible}">
                <Grid RowDefinitions="Auto,*,Auto,Auto,*">
                    <Border Classes="section-header" CornerRadius="5,5,0,0" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                            <TextBlock Text="连接" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding EditSavedConnectionCommand}" IsEnabled="{Binding CanEditSavedConnection}"
                                    Padding="5,2" ToolTip.Tip="编辑选中的已保存连接">
                                <ic:FluentIcon Icon="Edit" IconSize="Size16" />
                            </Button>
                            <Button Grid.Column="2" Command="{Binding ForgetSavedConnectionCommand}" IsEnabled="{Binding CanForgetSavedConnection}"
                                    Padding="5,2" ToolTip.Tip="移除选中的已保存连接">
                                <ic:FluentIcon Icon="Delete" IconSize="Size16" />
                            </Button>
                            <Button Grid.Column="3" Command="{Binding OpenConnectionCommand}" Padding="5,2" ToolTip.Tip="新建连接">
                                <ic:FluentIcon Icon="Add" IconSize="Size16" />
                            </Button>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding SavedConnections}" SelectedItem="{Binding SelectedSavedConnection}"
                             controls:ConnectionActivation.Command="{Binding OpenSavedConnectionCommand}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="connections:ConnectionProfile">
                                <Grid ColumnDefinitions="24,*,Auto" Margin="2,1">
                                    <ic:FluentIcon Icon="Database" IconSize="Size16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding DataType}" FontSize="11" Foreground="{DynamicResource WorkbenchMutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Classes="section-header" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,1,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <ic:FluentIcon Icon="FolderOpen" IconSize="Size16" />
                                <TextBlock Text="对象" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ActiveConnectionName}" FontSize="11" Foreground="{DynamicResource WorkbenchMutedTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBox Grid.Row="3" Margin="8" PlaceholderText="筛选已加载对象…" Text="{Binding TreeFilter, Mode=TwoWay}" />

                    <TreeView Grid.Row="4" ItemsSource="{Binding VisibleDatabases}" SelectedItem="{Binding SelectedNode}"
                              controls:TreeItemActivation.Command="{Binding OpenDataCommand}" Margin="4,0,4,6">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding VisibleChildren}" x:DataType="vm:ConnectionTreeNodeViewModel">
                                <Grid ColumnDefinitions="28,*" MinWidth="0" IsVisible="{Binding IsVisible}" ContextMenu="{StaticResource ObjectContextMenu}">
                                    <Border Width="21" Height="18" CornerRadius="3" Background="{DynamicResource WorkbenchIconSurfaceBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource WorkbenchAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource WorkbenchBorderBrush}"
                          IsVisible="{Binding IsNavigatorVisible}" />

            <Border Grid.Column="2" Margin="6,10,10,10" Background="{DynamicResource WorkbenchPanelBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="1" CornerRadius="5">
                <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QueryTabViewModel">
                            <TextBlock Text="{Binding Header}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:QueryTabViewModel">
                            <views:QueryTabView />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
