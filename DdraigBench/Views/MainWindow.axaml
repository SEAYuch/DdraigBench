<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DdraigBench.ViewModels"
        xmlns:views="using:DdraigBench.Views"
        xmlns:ic="using:FluentIcons.Avalonia.Fluent"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="DdraigBench.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1000" Height="640"
        Title="DdraigBench">

    <Window.Styles>
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
            <Button Command="{Binding OpenConnectionCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:FluentIcon Icon="Database" IconVariant="Regular" IconSize="Size16"
                                   VerticalAlignment="Center" />
                    <TextBlock Text="新建连接…" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding NewQueryCommand}" Content="新建查询" />
            <Button Command="{Binding SelectedTab.ExecuteCommand}" Content="执行" />
            <Button Command="{Binding SelectedTab.CancelCommand}"
                    Content="取消"
                    IsEnabled="{Binding SelectedTab.CanCancel}" />
            <CheckBox Content="事务"
                      IsChecked="{Binding SelectedTab.UseTransaction}"
                      VerticalAlignment="Center" />
            <Button Command="{Binding SelectedTab.CommitCommand}"
                    Content="提交"
                    IsEnabled="{Binding SelectedTab.HasTransaction}" />
            <Button Command="{Binding SelectedTab.RollbackCommand}"
                    Content="回滚"
                    IsEnabled="{Binding SelectedTab.HasTransaction}" />
            <Button Command="{Binding SelectedTab.ExportCsvCommand}"
                    Content="导出 CSV"
                    IsEnabled="{Binding SelectedTab.CanExport}" />
            <Button Command="{Binding SelectedTab.ExportInsertCommand}"
                    Content="导出 INSERT"
                    IsEnabled="{Binding SelectedTab.CanExport}" />
            <Button Command="{Binding PreviewDdlCommand}"
                    Content="预览 DDL"
                    IsEnabled="{Binding CanPreviewDdl}" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid ColumnDefinitions="280,*">
            <TreeView ItemsSource="{Binding Databases}"
                      SelectedItem="{Binding SelectedNode}"
                      Margin="8">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}"
                                      x:DataType="vm:ConnectionTreeNodeViewModel">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <TabControl Grid.Column="1"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab}"
                        Margin="0,0,8,8">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QueryTabViewModel">
                        <TextBlock Text="{Binding Header}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:QueryTabViewModel">
                        <views:QueryTabView />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>

</Window>
