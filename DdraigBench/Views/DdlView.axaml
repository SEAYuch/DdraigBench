<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DdraigBench.ViewModels"
        x:Class="DdraigBench.Views.DdlView"
        x:DataType="vm:DdlViewModel"
        Width="720" Height="480"
        CanResize="True"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16" LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{DynamicResource WorkbenchSubtleBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="1" CornerRadius="4"
                Padding="10,7" Margin="0,0,0,9">
            <TextBlock Opacity="0.75" Text="DDL 定义 · Ctrl+A 全选 · Ctrl+C 复制" />
        </Border>

        <Button DockPanel.Dock="Bottom"
                Content="关闭"
                HorizontalAlignment="Right"
                 Margin="0,9,0,0"
                Command="{Binding CloseCommand}" />

        <TextBox Text="{Binding Ddl, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                 FontSize="12"
                 BorderBrush="{DynamicResource WorkbenchBorderBrush}"
                 BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </DockPanel>

</Window>
