<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DdraigBench.ViewModels"
        x:Class="DdraigBench.Views.ConnectionDialogView"
        x:DataType="vm:ConnectionDialogViewModel"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        Title="新建连接"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16" Spacing="6">
        <TextBlock Text="Provider" />
        <ComboBox ItemsSource="{Binding ProviderOptions}"
                  SelectedItem="{Binding SelectedProvider}"
                  HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProviderOption">
                    <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel IsVisible="{Binding IsFileBased}" Spacing="6">
            <TextBlock Text="数据库文件" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding FilePath}" PlaceholderText="选择 .db / .sqlite / .sqlite3" />
                <Button Grid.Column="1" Margin="8,0,0,0" Content="浏览…" Command="{Binding BrowseCommand}" />
            </Grid>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsServerBased}" Spacing="6">
            <TextBlock Text="主机 / 端口" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding Host}" PlaceholderText="主机" />
                <TextBox Grid.Column="1" Margin="8,0,0,0" Width="90" Text="{Binding Port}" PlaceholderText="端口" />
            </Grid>
            <TextBox Text="{Binding Database}" PlaceholderText="数据库名" />
            <TextBox Text="{Binding User}" PlaceholderText="用户名" />
            <TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="口令" />
        </StackPanel>

        <TextBlock Text="连接名（留空自动生成）" />
        <TextBox Text="{Binding Name}" />

        <TextBlock Text="{Binding Error}"
                   IsVisible="{Binding HasError}"
                   Foreground="#C42B1C"
                   TextWrapping="Wrap" />

        <TextBlock Text="✔ 连接成功" IsVisible="{Binding TestSucceeded}" Foreground="#107C10" />
        <TextBlock Text="{Binding TestFailure}"
                   IsVisible="{Binding HasTestFailure}"
                   Foreground="#C42B1C"
                   TextWrapping="Wrap" />

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0">
            <Button Grid.Column="0" Content="测试连接" Command="{Binding TestCommand}" />
            <Button Grid.Column="2" Content="取消" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="确定" Command="{Binding ConfirmCommand}" />
        </Grid>
    </StackPanel>

</Window>
