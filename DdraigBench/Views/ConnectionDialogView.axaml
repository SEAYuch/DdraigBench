<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DdraigBench.ViewModels"
        x:Class="DdraigBench.Views.ConnectionDialogView"
        x:DataType="vm:ConnectionDialogViewModel"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        Title="新建连接"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource WorkbenchAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchAccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.error-message">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchErrorTextBrush}" />
        </Style>
        <Style Selector="Border.success-message">
            <Setter Property="Background" Value="{DynamicResource WorkbenchSuccessSurfaceBrush}" />
        </Style>
        <Style Selector="TextBlock.success-message">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchSuccessTextBrush}" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="22" Spacing="8">
        <TextBlock Text="Provider" Classes="field-label" />
        <ComboBox ItemsSource="{Binding ProviderOptions}"
                  SelectedItem="{Binding SelectedProvider}"
                  HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProviderOption">
                    <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel IsVisible="{Binding IsFileBased}" Spacing="6">
            <TextBlock Text="数据库文件" Classes="field-label" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding FilePath}" PlaceholderText="选择 .db / .sqlite / .sqlite3" />
                <Button Grid.Column="1" Margin="8,0,0,0" Content="浏览…" Command="{Binding BrowseCommand}" />
            </Grid>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsServerBased}" Spacing="6">
            <TextBlock Text="主机 / 端口" Classes="field-label" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding Host}" PlaceholderText="主机" />
                <TextBox Grid.Column="1" Margin="8,0,0,0" Width="90" Text="{Binding Port}" PlaceholderText="端口" />
            </Grid>
            <TextBox Text="{Binding Database}" PlaceholderText="数据库名" />
            <TextBox Text="{Binding User}" PlaceholderText="用户名 / 登录名" />
            <TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="口令" />
            <CheckBox IsVisible="{Binding IsSqlServer}"
                      IsChecked="{Binding TrustServerCertificate}"
                      Content="信任服务器证书（仅自签证书/测试环境）" />
        </StackPanel>

        <TextBlock Text="连接名（留空自动生成）" Classes="field-label" />
        <TextBox Text="{Binding Name}" />

        <TextBlock Classes="error-message" Text="{Binding Error}"
                   IsVisible="{Binding HasError}"
                   TextWrapping="Wrap" />

        <Border Classes="success-message" IsVisible="{Binding TestSucceeded}" CornerRadius="4" Padding="8,6">
            <TextBlock Classes="success-message" Text="连接成功" />
        </Border>
        <TextBlock Classes="error-message" Text="{Binding TestFailure}"
                   IsVisible="{Binding HasTestFailure}"
                   TextWrapping="Wrap" />

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0">
            <Button Grid.Column="0" Content="测试连接" Command="{Binding TestCommand}" />
            <Button Grid.Column="2" Content="取消" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="3" Classes="primary" Content="连接" Command="{Binding ConfirmCommand}" />
        </Grid>
    </StackPanel>

</Window>
