<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:themes="using:Avalonia.Styling"
             x:Class="DdraigBench.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <!--
            正文前景色必须设在 Window 上、靠继承链下发，不能写 `Style Selector="TextBlock"`：
            隐式样式直接落在每个 TextBlock 上，会盖掉强调按钮（Button.accent / Button.primary）
            自身的前景色——蓝底配深色正文（浅色主题对比度约 2.2:1，A2，2026-10-11 实测）。
            设在 Window 上时按钮的 Foreground 在继承链上更近，自然胜出。
        -->
        <Style Selector="Window">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WorkbenchBackgroundBrush" Color="#F1F3F6" />
                    <SolidColorBrush x:Key="WorkbenchPanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WorkbenchSubtleBrush" Color="#E7EBF1" />
                    <SolidColorBrush x:Key="WorkbenchBorderBrush" Color="#BCC5D1" />
                    <SolidColorBrush x:Key="WorkbenchTextBrush" Color="#1B2430" />
                    <SolidColorBrush x:Key="WorkbenchMutedTextBrush" Color="#566273" />
                    <SolidColorBrush x:Key="WorkbenchAccentBrush" Color="#155A9C" />
                    <SolidColorBrush x:Key="WorkbenchAccentTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WorkbenchWarningSurfaceBrush" Color="#FFF2D8" />
                    <SolidColorBrush x:Key="WorkbenchWarningBorderBrush" Color="#B86A00" />
                    <SolidColorBrush x:Key="WorkbenchWarningTextBrush" Color="#603600" />
                    <SolidColorBrush x:Key="WorkbenchSuccessSurfaceBrush" Color="#E4F4E7" />
                    <SolidColorBrush x:Key="WorkbenchSuccessTextBrush" Color="#155B27" />
                    <SolidColorBrush x:Key="WorkbenchErrorTextBrush" Color="#A11B1B" />
                    <SolidColorBrush x:Key="WorkbenchIconSurfaceBrush" Color="#DCE8F5" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WorkbenchBackgroundBrush" Color="#171A1F" />
                    <SolidColorBrush x:Key="WorkbenchPanelBrush" Color="#20252C" />
                    <SolidColorBrush x:Key="WorkbenchSubtleBrush" Color="#292F38" />
                    <SolidColorBrush x:Key="WorkbenchBorderBrush" Color="#414A57" />
                    <SolidColorBrush x:Key="WorkbenchTextBrush" Color="#F1F4F8" />
                    <SolidColorBrush x:Key="WorkbenchMutedTextBrush" Color="#B2BBC8" />
                    <SolidColorBrush x:Key="WorkbenchAccentBrush" Color="#397DB8" />
                    <SolidColorBrush x:Key="WorkbenchAccentTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WorkbenchWarningSurfaceBrush" Color="#3B2B16" />
                    <SolidColorBrush x:Key="WorkbenchWarningBorderBrush" Color="#D89B3C" />
                    <SolidColorBrush x:Key="WorkbenchWarningTextBrush" Color="#FFE2A8" />
                    <SolidColorBrush x:Key="WorkbenchSuccessSurfaceBrush" Color="#1D3825" />
                    <SolidColorBrush x:Key="WorkbenchSuccessTextBrush" Color="#B5E7BF" />
                    <SolidColorBrush x:Key="WorkbenchErrorTextBrush" Color="#FFB4AB" />
                    <SolidColorBrush x:Key="WorkbenchIconSurfaceBrush" Color="#30445A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
